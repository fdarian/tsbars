{
	"name": "tsbars",
	"version": "0.0.0",
	"description": "Typed Handlebars imports via TypeScript content mappers",
	"type": "module",
	"license": "MIT",
	"author": "Farrel Darian",
	"packageManager": "pnpm@12.15.0",
	"files": [
		"dist",
		"wasm",
		"bin",
		"README.md",
		"LICENSE"
	],
	"exports": {
		"./compile": {
			"types": "./dist/compile.d.ts",
			"import": "./dist/compile.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"import": "./dist/vite.js"
		},
		"./bun": {
			"types": "./dist/bun.d.ts",
			"import": "./dist/bun.js"
		},
		"./package.json": "./package.json"
	},
	"imports": {
		"#src/*": "./src/*"
	},
	"typescript": {
		"contentMapper": {
			"exec": [
				"node",
				"bin/mapper.js"
			],
			"compilerOptions": []
		}
	},
	"scripts": {
		"build": "tsdown",
		"format": "biome check --write && cargo fmt --all",
		"check:lint": "biome lint .",
		"check:type": "tsc --noEmit",
		"build:native": "cargo build --release -p tsbars-mapper",
		"test": "bun test"
	},
	"peerDependencies": {
		"handlebars": "^4.7.0",
		"vite": ">=5"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@total-typescript/tsconfig": "1.0.4",
		"@types/bun": "1.4.4",
		"handlebars": "4.7.10",
		"tsdown": "0.23.1",
		"typescript": "7.1.0-beta",
		"vite": "8.3.5"
	}
}
