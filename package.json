{
	"name": "tsbars",
	"version": "0.1.0",
	"description": "Typed Handlebars imports via TypeScript content mappers",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fdarian/tsbars.git"
	},
	"author": "Farrel Darian",
	"packageManager": "pnpm@12.15.0",
	"files": [
		"dist",
		"wasm",
		"bin",
		"README.md",
		"LICENSE"
	],
	"exports": {
		"./compile": {
			"types": "./dist/compile.d.ts",
			"import": "./dist/compile.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"import": "./dist/vite.js"
		},
		"./bun": {
			"types": "./dist/bun.d.ts",
			"import": "./dist/bun.js"
		},
		"./package.json": "./package.json"
	},
	"imports": {
		"#src/*": "./src/*"
	},
	"typescript": {
		"contentMapper": {
			"exec": [
				"node",
				"bin/mapper.js"
			],
			"compilerOptions": []
		}
	},
	"scripts": {
		"build": "tsdown && pnpm run build:wasm",
		"build:wasm": "cargo build --release --target wasm32-wasip1 -p tsbars-mapper && mkdir -p wasm && cp target/wasm32-wasip1/release/tsbars-mapper.wasm wasm/",
		"format": "biome check --write && cargo fmt --all",
		"check": "pnpm run check:type && pnpm run check:lint && pnpm run check:rust && pnpm run test",
		"check:type": "tsc --noEmit",
		"check:lint": "biome lint .",
		"check:rust": "cargo clippy --all-targets -- -D warnings && cargo clippy --target wasm32-wasip1 -p tsbars-mapper -- -D warnings",
		"test": "bun test && pnpm run test:rust",
		"test:rust": "cargo test",
		"ci:version": "changeset version",
		"ci:release": "pnpm run build && changeset publish"
	},
	"peerDependencies": {
		"handlebars": "^4.7.0",
		"vite": ">=5"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@changesets/cli": "3.0.3",
		"@total-typescript/tsconfig": "1.0.4",
		"@types/bun": "1.4.4",
		"handlebars": "4.7.10",
		"tsdown": "0.23.1",
		"typescript": "7.1.0-beta",
		"vite": "8.3.5"
	}
}
